{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "separate-pull-requests": true,
  "include-component-in-tag": false,
  "include-v-in-tag": false,
  "packages": {
    ".": {
      "package-name": "fleche",
      "bump-minor-pre-major": true,
      "exclude-paths": [
        "src/fleche-numpy",
        "src/fleche-pandas"
      ]
    },
    "src/fleche-numpy": {
      "package-name": "fleche-numpy",
      "component": "fleche-numpy",
      "release-type": "python",
      "include-component-in-tag": true
    },
    "src/fleche-pandas": {
      "package-name": "fleche-pandas",
      "component": "fleche-pandas",
      "release-type": "python",
      "include-component-in-tag": true
    }
  }
}
